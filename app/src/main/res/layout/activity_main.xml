<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark_teal"
    tools:context=".ui.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="SMS Clone"
            app:titleCentered="true"
            app:titleTextColor="@color/on_surface_light"
            app:titleTextAppearance="@style/TextAppearance.Material3.HeadlineMedium" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Hero Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/secondary_teal"
                app:cardCornerRadius="32dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/dawillygene"
                        app:tint="@color/accent_mint"
                        android:contentDescription="App Logo" />

                    <TextView
                        android:id="@+id/heroStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="System Protected"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="@color/accent_mint"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Monitoring all SMS changes"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/on_surface_light"
                        android:alpha="0.7" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"
                android:text="FORENSIC EXPORT"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/accent_mint"
                android:letterSpacing="0.1" />

            <!-- Forensic Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="28dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <CheckBox android:id="@+id/cbCallLogs" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Call Logs" android:textColor="@color/on_surface_light" android:buttonTint="@color/accent_mint" />
                    <CheckBox android:id="@+id/cbContacts" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contacts" android:textColor="@color/on_surface_light" android:buttonTint="@color/accent_mint" />
                    <CheckBox android:id="@+id/cbCalendar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Calendar Events" android:textColor="@color/on_surface_light" android:buttonTint="@color/accent_mint" />
                    <CheckBox android:id="@+id/cbBrowser" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Browser History" android:textColor="@color/on_surface_light" android:buttonTint="@color/accent_mint" />
                    <CheckBox android:id="@+id/cbMediaExif" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Media EXIF Metadata" android:textColor="@color/on_surface_light" android:buttonTint="@color/accent_mint" />
                    <CheckBox android:id="@+id/cbAppUsage" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="App Usage Stats" android:textColor="@color/on_surface_light" android:buttonTint="@color/accent_mint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnForensicExport"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="16dp"
                        android:text="START FORENSIC ACQUISITION"
                        android:textColor="@color/primary_dark_teal"
                        android:backgroundTint="@color/accent_mint"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"
                        app:cornerRadius="20dp"
                        app:icon="@android:drawable/ic_menu_camera"
                        app:iconTint="@color/primary_dark_teal"
                        app:iconSize="24dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"
                android:text="SETTINGS"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/accent_mint"
                android:letterSpacing="0.1" />

            <!-- Settings -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="28dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:padding="16dp"
                        android:text="MANUAL SMS EXPORT"
                        android:textColor="@color/on_surface_light"
                        style="@style/Widget.Material3.Button.TextButton"
                        app:icon="@android:drawable/ic_menu_upload"
                        app:iconTint="@color/accent_mint" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        app:dividerColor="@color/secondary_teal" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectPath"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:padding="16dp"
                        android:text="STORAGE PATH"
                        android:textColor="@color/on_surface_light"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        app:icon="@android:drawable/ic_menu_save"
                        app:iconTint="@color/accent_mint" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        app:dividerColor="@color/secondary_teal" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Daily Auto-Sync"
                            android:textColor="@color/on_surface_light"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchAutoBackup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="@color/accent_mint"
                            app:trackTint="@color/secondary_teal" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Status Logs -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/primary_dark_teal"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/secondary_teal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="System Initialized"
                        android:textAlignment="center"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/on_surface_light"
                        android:alpha="0.6" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressIndicator"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/accent_mint"
        app:trackColor="@color/secondary_teal"
        app:layout_anchor="@id/toolbar"
        app:layout_anchorGravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>